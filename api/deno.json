{
  "name": "2vhutemas-api",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.14",
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "jose": "npm:jose@^5.9.6"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch src/main.ts",
    "start": "deno run --allow-net --allow-env src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt src",
    "lint": "deno lint src"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lock": false
}
